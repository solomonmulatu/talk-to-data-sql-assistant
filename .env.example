OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o

# Local Postgres, or a Supabase URI (postgres:// / postgresql:// are normalized to postgresql+psycopg://).
# Supabase hosts automatically get sslmode=require when missing.
DATABASE_URL=postgresql+psycopg://talk_to_data:change_this_local_password@localhost:5432/talk_to_data

# Used by the API settings module (optional for local Streamlit).
API_BASE_URL=http://127.0.0.1:8000

# Streamlit: full URL to the ask endpoint. On Render, set this to your API service, e.g.
# API_URL=https://your-api.onrender.com/ask
# If unset, Streamlit uses API_BASE_URL + /ask (or http://localhost:8000/ask).
# API_URL=http://localhost:8000/ask
